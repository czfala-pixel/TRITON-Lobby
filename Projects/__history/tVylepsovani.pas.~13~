unit tVylepsovani;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, System.Generics.Collections, Vcl.Graphics, Vcl.Controls,
  Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ComCtrls, Vcl.ExtCtrls,
  Vcl.ImgList, Vcl.Clipbrd, System.ImageList;

type
  TSurovinaItem = record
    Nazev: string;
    PocetNaKrok: Int64;
  end;

  TUrovenVylepseni = record
    StupenPoVylepseni: Integer; // 1 = z +0 na +1, ..., 9 = z +8 na +9
    Suroviny: TArray<TSurovinaItem>;
  end;

  TTypPredmetu = record
    Nazev: string;
    MinStupen: Integer;
    MaxStupen: Integer;
    Urovne: TArray<TUrovenVylepseni>;
  end;

  TfrmVylepsovani = class(TForm)
    pnlNastaveni: TPanel;
    lblTyp: TLabel;
    cmbTypPredmetu: TComboBox;
    lblOd: TLabel;
    lblDo: TLabel;
    btnVypocitat: TButton;
    btnKopirovat: TButton;
    lvVysledek: TListView;
    ilSuroviny: TImageList;
    cmbStupenDo: TComboBox;
    cmbStupenOd: TComboBox;
    procedure FormCreate(Sender: TObject);
    procedure btnVypocitatClick(Sender: TObject);
    procedure btnKopirovatClick(Sender: TObject);
    procedure ZmenaParametru(Sender: TObject);
  private
    FData: TArray<TTypPredmetu>;
    procedure NaplnRecepty;
    procedure NaplnRozsahStupnu;
    procedure VypocitejAZobraz;
    function IndexIkonkyProSurovinu(const ANazev: string): Integer;
    function FormatujMnozstvi(const ANazev: string; AHodnota: Int64): string;
  public
  end;

var
  frmVylepsovani: TfrmVylepsovani;

implementation

{$R *.dfm}

function Surovina(const ANazev: string; APocet: Int64): TSurovinaItem;
begin
  Result.Nazev := ANazev;
  Result.PocetNaKrok := APocet;
end;

